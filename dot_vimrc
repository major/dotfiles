call plug#begin('~/.vim/plugged')
Plug 'vim-airline/vim-airline', { 'on': 'VimEnter' }
Plug 'sickill/vim-monokai'
Plug 'ghifarit53/tokyonight-vim'
Plug 'tribela/vim-transparent'

Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim', { 'on': ['File', 'GFiles', 'Buffers', 'Lines', 'BLines'] }

Plug 'yegappan/lsp'

Plug 'tpope/vim-commentary'
Plug 'tpope/vim-endwise'
Plug 'tpope/vim-fugitive'
Plug 'tpope/vim-sensible'
Plug 'tpope/vim-surround'
Plug 'tpope/vim-vinegar'
Plug 'preservim/nerdtree'

" Markdown / blog post writing efficiency
Plug 'junegunn/limelight.vim'
Plug 'godlygeek/tabular'
Plug 'preservim/vim-markdown'
Plug 'iamcco/markdown-preview.nvim', { 'do': { -> mkdp#util#install() }, 'for': ['markdown'] }

call plug#end()

nnoremap <silent> <leader>e :NERDTreeToggle<CR>
autocmd VimEnter * ++nested NERDTree

" Register pyright as the LSP server for Python
let g:lsp_servers = [{'name': 'pyright', 'filetype': ['python'], 'path': '/home/major/.local/bin/pyright-langserver', 'args': ['--stdio']}]
autocmd User LspSetup call LspAddServer(g:lsp_servers)

set t_Co=256
colorscheme tokyonight

" Use hybrid numbering in the active window
" Use regular numbering in the inactive windows
:set number
:augroup numbertoggle
:  autocmd!
:  autocmd BufEnter,FocusGained,InsertLeave,WinEnter * if &nu && mode() != "i" | set rnu   | endif
:  autocmd BufLeave,FocusLost,InsertEnter,WinLeave   * if &nu                  | set nornu | endif
:augroup END

" Detect files changed outside Vim while idle or returning to Vim
set autoread
set updatetime=1000
set mouse=a
augroup external_file_changes
  autocmd!
  autocmd FocusGained,BufEnter,CursorHold,CursorHoldI * checktime
augroup END

" Spaces instead of tabs
set tabstop=4
set expandtab

" Toggle spell check
:map <F5> :setlocal spell! spelllang=en_us<CR>

" vim-markdown enables folding by default, but I find this confusing
let g:vim_markdown_folding_disabled = 1
