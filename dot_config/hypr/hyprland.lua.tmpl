local terminal = "kitty"
local fileManager = "nautilus"
local menu = "wofi --show drun"

local screenshot = "hyprshot -m region --clipboard-only"
local windowScreenshot = "hyprshot -m window --clipboard-only"

local lock = "hyprlock"
local picker = "hyprpicker -ai"
local emojiPicker = "rofimoji --action copy --selector wofi --clipboarder wl-copy --typer wtype"

