{
  "keybinds": {
    "input.newline": "shift+return,ctrl+return,ctrl+j",
    "prompt.queue": "alt+return"
  },
  "theme": {
    "name": "opencode",
    "mode": "dark"
  },
  "plugins": [
    "-oc-go-usage"
  ],
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "single": false,
    "tree": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "image_preview": false,
    "markdown": "rendered",
    "new_location": "launch",
    "verbosity": "high"
  },
  "animations": true,
  "tabs": {
    "enabled": true,
    "layout": "vertical",
    "scope": "cwd",
    "indicators": "status"
  },
  "attention": {
    "sound": true,
    "volume": 0.30000000000000016,
    "notifications": true
  },
  "debug": {
    "turn_tokens": false,
    "devtools": false
  },
  "prompt": {
    "image_preview": false,
    "paste": "full"
  },
  "terminal": {
    "copy": "select"
  }
}
