{
  "keybinds": {
    "input.newline": "shift+return,ctrl+return,ctrl+j",
    "prompt.queue": "alt+return"
  },
  "theme": {
    "name": "opencode",
    "mode": "system"
  },
  "plugins": [],
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "single": false,
    "tree": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "image_preview": false
  },
  "animations": true,
  "tabs": {
    "enabled": true,
    "layout": "vertical",
    "scope": "cwd"
  },
  "attention": {
    "enabled": true
  },
  "debug": {
    "turn_tokens": false,
    "devtools": false
  },
  "prompt": {
    "image_preview": false,
    "paste": "compact"
  }
}
