{
  "keybinds": {
    "input.newline": "shift+return,ctrl+return,ctrl+j",
    "prompt.queue": "alt+return"
  },
  "theme": {
    "name": "tokyonight",
    "mode": "dark"
  },
  "plugins": [
    "oh-my-opencode-slim@2.2.17",
    "-oc-go-usage"
  ],
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "single": false,
    "tree": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "image_preview": false,
    "markdown": "rendered",
    "new_location": "launch"
  },
  "animations": true,
  "tabs": {
    "enabled": true,
    "layout": "vertical",
    "scope": "cwd"
  },
  "attention": {
    "enabled": true
  },
  "debug": {
    "turn_tokens": false,
    "devtools": false
  },
  "prompt": {
    "image_preview": false,
    "paste": "full"
  }
}
