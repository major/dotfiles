{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/bash",
  "update": "auto",
  "worktree": {
    "directory": ".worktrees"
  },
  "lsp": true,
  "agents": {
    "title": {
      "model": "openai/gpt-5.4-mini"
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.zshrc.local",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "1password": {
        "type": "local",
        "command": [
          "/bin/bash",
          "-c",
          "(1password-mcp)"
        ],
        "disabled": true
      },
      "jira": {
        "type": "local",
        "command": [
          "/home/major/.local/bin/uv",
          "run",
          "mcp-atlassian"
        ],
        "cwd": "/home/major/git/major/mcp-atlassian",
        "environment": {
          "JIRA_URL": "https://{env:JIRA_HOST}",
          "JIRA_USERNAME": "{env:JIRA_EMAIL}",
          "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
          "TOOLSETS": "default,jira_links,jira_attachments,jira_users"
        }
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        }
      },
      "ast-grep": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/ast-grep/ast-grep-mcp",
          "ast-grep-server"
        ]
      }
    }
  },
  "plugins": [
    "oh-my-opencode-slim"
  ],
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "branch": "v2",
      "description": "Use for OpenCode V2 implementation details and source"
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
