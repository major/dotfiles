{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/bash",
  "update": "auto",
  "worktree": {
    "directory": ".worktrees"
  },
  "lsp": true,
  "agents": {
    "title": {
      "model": "openai/gpt-5.4-mini"
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.zshrc.local",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "1password": {
        "type": "local",
        "command": [
          "/bin/bash",
          "-c",
          "(1password-mcp)"
        ],
        "disabled": true
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        }
      }
    }
  },
  "plugins": [
    "oh-my-opencode-slim@3.0.2"
  ],
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "branch": "v2",
      "description": "Use for OpenCode V2 implementation details and source"
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
