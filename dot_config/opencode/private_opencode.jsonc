{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/AGENTS.md",
    "~/.config/opencode/AGENTS_redhat.md"
  ],
  "shell": "/bin/bash",
  "update": "auto",
  "worktree": {
    "directory": ".worktrees"
  },
  "warming": true,
  "lsp": true,
  "websearch": {
    "provider": "exa"
  },
  "agents": {
    "build": {
      "model": "anthropic/claude-sonnet-5-5#high"
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.zshrc.local",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/git/*/AGENTS.md",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/git/*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "1password": {
        "type": "local",
        "command": [
          "/bin/bash",
          "-c",
          "(1password-mcp)"
        ],
        "disabled": true
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        }
      }
    }
  },
  "plugins": [
    "-@mhayden/opencode-mythos-plugin@0.1.1",
    "-opencode.prompt.verbosity"
  ],
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "branch": "v2",
      "description": "Use for OpenCode V2 implementation details and source"
    }
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
