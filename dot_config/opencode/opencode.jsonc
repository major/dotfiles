{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "agents": {
    "title": {
      "model": "openai/gpt-5.4-mini"
    },
    "general": {
      "model": "openai/gpt-5.6-luna"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna"
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.zshrc.local",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/go/pkg/mod/**",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "1password": {
        "type": "local",
        "command": [
          "/bin/bash",
          "-c",
          "(1password-mcp)"
        ],
        "disabled": true
      },
      "jira": {
        "type": "local",
        "command": ["/home/major/.local/bin/uv", "run", "mcp-atlassian"],
        "cwd": "/home/major/git/major/mcp-atlassian",
        "environment": {
          "JIRA_URL": "https://redhat.atlassian.net",
          "JIRA_USERNAME": "mhayden@redhat.com",
          "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}",
          "TOOLSETS": "default,jira_links,jira_attachments,jira_users"
        }
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        }
      }
    }
  },
  "plugins": [
    "oh-my-opencode-slim@2.2.17",
  ],
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "branch": "v2",
      "description": "Use for OpenCode V2 implementation details and source"
    },
    "schwab-py": {
      "repository": "alexgolec/schwab-py",
      "description": "Use for schwab-py Charles Schwab API wrapper implementation details and source"
    },
    "lightwell-bootstrap": {
      "repository": "git@gitlab.cee.redhat.com:lightwell/lightwell-bootstrap.git",
      "branch": "main",
      "description": "Use for Lightwell shared agent tooling, skills, and workspace conventions"
    }
  }
}
