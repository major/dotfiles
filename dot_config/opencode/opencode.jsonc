{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "agents": {
    "title": {
      "model": "openai/gpt-5.4-mini"
    },
    "general": {
      "model": "openai/gpt-5.6-terra#medium",
      "disabled": true
    },
    "explore": {
      "model": "openai/gpt-5.6-luna#medium",
      "disabled": true
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.zshrc.local",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/go/pkg/mod/**",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "1password": {
        "type": "local",
        "command": [
          "/bin/bash",
          "-c",
          "(1password-mcp)"
        ],
        "disabled": true
      }
    }
  },
  "plugins": [
    "~/.config/opencode/plugins/zellij-tabula.ts",
    "opencode-chatgpt-websearch"
  ],
  "websearch": {
    "provider": "chatgpt"
  }
}
